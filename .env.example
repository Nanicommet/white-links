# ═══════════════════════════════════════════════════════════════════
# WHITE LINKS — Environment variables
# Copy the values into Vercel → Settings → Environment Variables.
# This file is a TEMPLATE only — never put real secrets in it.
# ═══════════════════════════════════════════════════════════════════

# ── 1. DATABASE (Supabase Postgres) — REQUIRED ──────────────────────
# Supabase Dashboard → Connect (top bar) → "Transaction pooler" string
# → add ?pgbouncer=true&connection_limit=1 at the end.
# Replace [YOUR-PASSWORD] with the DB password you chose in Supabase.
DATABASE_URL="postgresql://postgres.XXXX:YOUR-PASSWORD@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Same dashboard → "Session pooler" string (port 5432). Used for migrations.
DIRECT_URL="postgresql://postgres.XXXX:YOUR-PASSWORD@aws-0-eu-west-3.pooler.supabase.com:5432/postgres"

# ── 2. ADMIN ACCOUNT — REQUIRED ─────────────────────────────────────
# The first server start creates this admin account automatically.
# Use a strong password and keep it safe — it's the club's master account.
ADMIN_EMAIL="bureau@whitelineissig.me"
ADMIN_PASSWORD="choose-a-strong-password-here"

# ── 3. SESSION SIGNING — RECOMMENDED ────────────────────────────────
# Random 64 hex chars. Generate with: openssl rand -hex 32
# (If empty, a secret is auto-generated and stored in the database.)
AUTH_SECRET=""

# ── 4. AI MODERATION (z.ai GLM) — OPTIONAL ──────────────────────────
# Get a key at https://z.ai (API keys section). Works with any
# OpenAI-compatible provider by changing AI_BASE_URL + AI_MODEL.
# Without a key the app still delivers messages instantly — the instant
# deterministic filters (contacts, links, insults) stay active and there
# is NO human approval queue. With a key, an extra AI layer also rejects
# identity hints; if the AI is down, messages are delivered anyway.
AI_API_KEY=""
AI_BASE_URL="https://api.z.ai/api/paas/v4"
AI_MODEL="glm-4.5-flash"

# ── 5. WHATSAPP CLOUD API — OPTIONAL ────────────────────────────────
# From https://developers.facebook.com → your app → WhatsApp → API Setup:
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# A random string YOU invent — you'll paste the same value in Meta's
# webhook configuration. Example: openssl rand -hex 16
WHATSAPP_VERIFY_TOKEN=""
# App Settings → Basic → App Secret:
WHATSAPP_APP_SECRET=""
WHATSAPP_API_VERSION="v21.0"
# "true" = simulate sends (nothing really goes out). Set "false" in production.
WHATSAPP_TEST_MODE="true"

# ── 5-bis. WHATSAPP VIA TWILIO (alternative to Meta Cloud API) ──────
# To use your Twilio WhatsApp number instead of Meta's Cloud API, set
# WHATSAPP_PROVIDER to "twilio" and fill in the three values below.
# Twilio Console → Account Info: Account SID + Auth Token.
# The WhatsApp sender looks like: whatsapp:+14155238886 (sandbox) or
# your approved Twilio WhatsApp number.
WHATSAPP_PROVIDER=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
# Optional: get delivered/read/failed status back into the admin panel
# (set it to https://your-app.vercel.app/api/webhooks/whatsapp-twilio)
TWILIO_STATUS_CALLBACK_URL=""

# ── 6. CRON PROTECTION — RECOMMENDED ────────────────────────────────
# Protects /api/system/tick (automatic phase transitions).
# Generate with: openssl rand -hex 16 — then use it in your cron service:
# https://your-app.vercel.app/api/system/tick?key=THE-VALUE
CRON_SECRET=""
